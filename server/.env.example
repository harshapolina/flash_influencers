PORT=3001
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/orbitly?retryWrites=true&w=majority
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/orbitly
NODE_ENV=development

# Google Sign-In (Web OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Optional comma-separated list if you also have Android/iOS clients
# GOOGLE_CLIENT_IDS=web-id,android-id

# Real email OTP via Nodemailer (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Orbitly <you@gmail.com>

# Dev only: also return OTP in API JSON (default false — email/Ethereal only)
OTP_EXPOSE_DEV_CODE=false

# Instagram / Meta (creator social connect) — leave blank until Meta app is ready
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/oauth/instagram

# Later phases (document only — do not commit secrets)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# FCM_SERVER_KEY=
# GOOGLE_MAPS_API_KEY=
# AI_API_KEY=
