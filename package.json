{
  "name": "orbitly-creator-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "npm run dev:api & npm run dev",
    "seed": "npm --prefix server run seed",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "android:live": "npx cap run android -l --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "google-auth-library": "^11.3.4",
    "nodemailer": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "rollup": "npm:@rollup/wasm-node",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
